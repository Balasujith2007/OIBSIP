# ==============================================================================
# OASIS INFOBYTE SIP — VOICE ASSISTANT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and populate with your own credentials if desired.
# NEVER commit your actual '.env' file with real credentials to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. WEATHER API CONFIGURATION (Optional)
# ------------------------------------------------------------------------------
# Sign up for a free API key at: https://openweathermap.org/api
# If left empty, the assistant automatically uses the live wttr.in fallback service.
WEATHER_API_KEY=your_openweathermap_api_key_here

# ------------------------------------------------------------------------------
# 2. EMAIL SENDER CONFIGURATION (Optional)
# ------------------------------------------------------------------------------
# For Gmail, use your email and an 'App Password' (not your main login password).
# How to generate Gmail App Password:
# Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_16_character_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# ------------------------------------------------------------------------------
# 3. TEXT-TO-SPEECH (TTS) CONFIGURATION (Optional)
# ------------------------------------------------------------------------------
# TTS Speech Rate (words per minute, default: 175)
TTS_RATE=175

# TTS Volume (0.0 to 1.0, default: 1.0)
TTS_VOLUME=1.0
